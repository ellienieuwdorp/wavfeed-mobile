{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": { "SOURCEMAP_FILE": "index.ios.map" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": { "SOURCEMAP_FILE": "index.ios.map" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "alpha"
      },
      "ios": {
        "ascAppId": "6817516210"
      }
    }
  }
}
